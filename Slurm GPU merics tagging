Two lightweight PrologSlurmctld / EpilogSlurmctld scripts that POST GPU allocation and release events to your metrics API. They are intentionally non-blocking so a tagging failure never delays job launch or completion.
#!/usr/bin/env python3
"""Slurm PrologSlurmctld: tag GPUs allocated to a job at launch."""
import json, os, sys, time, urllib.request

TAG_API = os.environ.get("GPU_TAG_API", "http://metrics-api:8080/gpu-tags")
TIMEOUT = 2.0

def main():
    job_id = os.environ.get("SLURM_JOB_ID")
    if not job_id:
        sys.exit(0)  # not a job context
    gpus = os.environ.get("SLURM_JOB_GPUS", "").split(",")
    gpus = [g.strip() for g in gpus if g.strip()]
    payload = {
        "event": "job_start",
        "job_id": job_id,
        "user": os.environ.get("SLURM_JOB_USER"),
        "partition": os.environ.get("SLURM_JOB_PARTITION"),
        "qos": os.environ.get("SLURM_JOB_QOS"),
        "gpus": gpus,
        "start_ts_ms": int(time.time() * 1000),
    }
    data = json.dumps(payload).encode()
    req = urllib.request.Request(TAG_API, data=data,
                                 headers={"Content-Type": "application/json"},
                                 method="POST")
    try:
        urllib.request.urlopen(req, timeout=TIMEOUT)
    except Exception as e:
        # Never block job launch on tagging failure
        print(f"gpu tag failed: {e}", file=sys.stderr)
    sys.exit(0)

if __name__ == "__main__":
    main()
