#!/usr/bin/env python3
"""Slurm EpilogSlurmctld: close GPU tag and snapshot final health."""
import json, os, sys, time, urllib.request

TAG_API = os.environ.get("GPU_TAG_API", "http://metrics-api:8080/gpu-tags")
TIMEOUT = 2.0

def main():
    job_id = os.environ.get("SLURM_JOB_ID")
    if not job_id:
        sys.exit(0)
    gpus = os.environ.get("SLURM_JOB_GPUS", "").split(",")
    gpus = [g.strip() for g in gpus if g.strip()]
    payload = {
        "event": "job_end",
        "job_id": job_id,
        "gpus": gpus,
        "end_ts_ms": int(time.time() * 1000),
        # Optional: pull final ECC snapshot here via pynvml if GPUs visible on controller
    }
    data = json.dumps(payload).encode()
    req = urllib.request.Request(TAG_API, data=data,
                                 headers={"Content-Type": "application/json"},
                                 method="POST")
    try:
        urllib.request.urlopen(req, timeout=TIMEOUT)
    except Exception as e:
        print(f"gpu untag failed: {e}", file=sys.stderr)
    sys.exit(0)

if __name__ == "__main__":
    main()

